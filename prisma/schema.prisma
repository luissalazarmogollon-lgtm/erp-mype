// =====================================================================
// ESQUEMA PRISMA — Sprint 1: Núcleo multiempresa, alta de empresa, seguridad
// Traducción de modelo_datos_erp_mype.sql (secciones 0 y 1).
// Los módulos operativos (ventas, compras, caja, planilla...) se agregan
// en los siguientes sprints, siguiendo el orden de especificacion_mvp_erp_mype.md.
//
// NOTA DE DISEÑO: `Usuario.id` es UUID (no BIGSERIAL como en el SQL original)
// porque coincide 1 a 1 con `auth.users.id` de Supabase Auth — así no
// duplicamos lógica de login/password, Supabase la maneja por nosotros.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// 0. Catálogos globales de plataforma
// ---------------------------------------------------------------------

model TipoNegocio {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique // 'Productos' | 'Servicios' | 'Productos y Servicios'
  rubros  Rubro[]
  empresas Empresa[]

  @@map("tipos_negocio")
}

model Rubro {
  id                       Int      @id @default(autoincrement())
  nombre                   String   @unique
  tipoNegocioSugeridoId    Int?     @map("tipo_negocio_sugerido_id")
  tipoNegocioSugerido      TipoNegocio? @relation(fields: [tipoNegocioSugeridoId], references: [id])
  requiereInventario       Boolean  @default(true) @map("requiere_inventario")
  requiereFichasTecnicas   Boolean  @default(true) @map("requiere_fichas_tecnicas")
  estado                   String   @default("activo") // activo | inactivo
  plantillasCatalogo       RubroPlantillaCatalogo[]
  empresas                 Empresa[]

  @@map("rubros")
}

// Catálogo semilla: al crear una empresa de este rubro, estos ítems se
// clonan hacia los catálogos propios de la empresa (RN-011).
model RubroPlantillaCatalogo {
  id            Int    @id @default(autoincrement())
  rubroId       Int    @map("rubro_id")
  rubro         Rubro  @relation(fields: [rubroId], references: [id])
  tipoCatalogo  String @map("tipo_catalogo") // categoria_insumo | categoria_producto | tipo_gasto | unidad_medida
  nombreItem    String @map("nombre_item")

  @@map("rubro_plantilla_catalogo")
}

model Banco {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("bancos")
}

// ---------------------------------------------------------------------
// 1. Núcleo: usuarios, empresas, seguridad
// ---------------------------------------------------------------------

model Usuario {
  id                       String   @id @db.Uuid // = auth.users.id de Supabase Auth
  nombres                  String
  apellidos                String
  email                    String   @unique
  telefono                 String?
  tipoActorBase            String   @map("tipo_actor_base") // asesor | asistente | cliente
  esSuperadminPlataforma   Boolean  @default(false) @map("es_superadmin_plataforma")
  estado                   String   @default("activo")
  fechaCreacion            DateTime @default(now()) @map("fecha_creacion")

  empresasComoAsesorPrincipal Empresa[]        @relation("AsesorPrincipal")
  asignaciones                UsuarioEmpresa[]
  auditorias                  Auditoria[]

  @@map("usuarios")
}

model Empresa {
  id                     BigInt   @id @default(autoincrement())
  razonSocial            String   @map("razon_social")
  nombreComercial        String   @map("nombre_comercial")
  ruc                    String?
  logoUrl                String?  @map("logo_url")
  tipoNegocioId          Int      @map("tipo_negocio_id")
  tipoNegocio            TipoNegocio @relation(fields: [tipoNegocioId], references: [id])
  rubroId                Int      @map("rubro_id")
  rubro                  Rubro    @relation(fields: [rubroId], references: [id])
  monedaOperacion        String   @default("PEN") @map("moneda_operacion") // PEN | USD
  aplicaIgv              Boolean  @default(true) @map("aplica_igv")
  tasaIgv                Decimal  @default(18.00) @map("tasa_igv") @db.Decimal(5, 2)
  regimenTributario      String?  @map("regimen_tributario") // NUEVO_RUS | RER | RMT | GENERAL
  capitalSocialInicial   Decimal  @default(0) @map("capital_social_inicial") @db.Decimal(12, 2)
  fechaAlta              DateTime @default(now()) @map("fecha_alta")
  estadoServicio         String   @default("activo") @map("estado_servicio") // activo | pausado | finalizado
  asesorPrincipalId      String?  @map("asesor_principal_id") @db.Uuid
  asesorPrincipal        Usuario? @relation("AsesorPrincipal", fields: [asesorPrincipalId], references: [id])
  estado                 String   @default("activo")

  modulos                EmpresaModulo[]
  asignaciones           UsuarioEmpresa[]
  auditorias              Auditoria[]
  categoriasInsumo       CategoriaInsumo[]
  unidadesMedida         UnidadMedida[]
  categoriasProducto     CategoriaProducto[]
  tiposGasto             TipoGasto[]
  metodosPago            MetodoPago[]
  conceptosMovimientoCaja ConceptoMovimientoCaja[]
  clientes               Cliente[]
  insumos                Insumo[]
  productos              Producto[]
  ventas                 Venta[]
  movimientosInventario  MovimientoInventario[]
  mermas                 Merma[]

  @@map("empresas")
}

// Qué módulos están activos para esta empresa (RN-012), predefinido según el rubro.
model EmpresaModulo {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modulo     String  // inventario_insumos | fichas_tecnicas | compras | cxc | cxp | caja_bancos |
                       // gastos | planilla | activos_fijos | prestamos_bancarios
  activo     Boolean @default(true)

  @@unique([empresaId, modulo])
  @@map("empresa_modulos")
}

model RolOperativo {
  id            Int    @id @default(autoincrement())
  nombre        String @unique // Gerencial | Admin Local | Cajero | Almacén-Cocina
  descripcion   String?

  permisos      RolPermiso[]
  asignaciones  UsuarioEmpresa[]

  @@map("roles_operativos")
}

model Permiso {
  id       Int    @id @default(autoincrement())
  modulo   String
  accion   String // ver | crear | editar | eliminar | aprobar

  roles    RolPermiso[]

  @@unique([modulo, accion])
  @@map("permisos")
}

model RolPermiso {
  rolOperativoId  Int
  rolOperativo    RolOperativo @relation(fields: [rolOperativoId], references: [id])
  permisoId       Int
  permiso         Permiso      @relation(fields: [permisoId], references: [id])

  @@id([rolOperativoId, permisoId])
  @@map("rol_permisos")
}

// Tabla puente clave del modelo multiempresa (ver sección 4.A de la arquitectura).
model UsuarioEmpresa {
  id               BigInt   @id @default(autoincrement())
  usuarioId        String   @map("usuario_id") @db.Uuid
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  empresaId        BigInt   @map("empresa_id")
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  tipoActor        String   @map("tipo_actor") // asesor | asistente | cliente
  rolOperativoId   Int      @map("rol_operativo_id")
  rolOperativo     RolOperativo @relation(fields: [rolOperativoId], references: [id])
  estado           String   @default("activo")
  fechaAsignacion  DateTime @default(now()) @map("fecha_asignacion")

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresa")
}

model Auditoria {
  id              BigInt   @id @default(autoincrement())
  usuarioId       String?  @map("usuario_id") @db.Uuid
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  empresaId       BigInt?  @map("empresa_id")
  empresa         Empresa? @relation(fields: [empresaId], references: [id])
  tablaAfectada   String   @map("tabla_afectada")
  registroId      BigInt   @map("registro_id")
  accion          String   // crear | editar | eliminar | aprobar
  valorAnterior   Json?    @map("valor_anterior")
  valorNuevo      Json?    @map("valor_nuevo")
  fecha           DateTime @default(now())
  ipOrigen        String?  @map("ip_origen")

  @@index([empresaId, tablaAfectada, registroId])
  @@map("auditoria")
}

// ---------------------------------------------------------------------
// 2. Catálogos por empresa (sección 3 de la arquitectura)
// Se pre-cargan al crear la empresa clonando rubro_plantilla_catalogo
// (RN-011), y luego son 100% editables por el cliente.
// ---------------------------------------------------------------------

model CategoriaInsumo {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nombre     String
  insumos    Insumo[]

  @@unique([empresaId, nombre])
  @@map("categorias_insumo")
}

model UnidadMedida {
  id           BigInt  @id @default(autoincrement())
  empresaId    BigInt  @map("empresa_id")
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  nombre       String
  abreviatura  String
  insumos      Insumo[]
  fichasTecnicas FichaTecnica[]

  @@unique([empresaId, nombre])
  @@map("unidades_medida")
}

model CategoriaProducto {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nombre     String
  productos  Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias_producto")
}

model TipoGasto {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nombre     String

  @@unique([empresaId, nombre])
  @@map("tipos_gasto")
}

// No viene de plantilla de rubro — set estándar igual para toda empresa
// (ver sección 3 de la arquitectura), se crea con valores fijos al alta.
model MetodoPago {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nombre     String
  ventas     Venta[]

  @@unique([empresaId, nombre])
  @@map("metodos_pago")
}

model ConceptoMovimientoCaja {
  id         BigInt  @id @default(autoincrement())
  empresaId  BigInt  @map("empresa_id")
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nombre     String
  tipo       String  // ingreso | egreso

  @@map("conceptos_movimiento_caja")
}

// ---------------------------------------------------------------------
// 3. Ventas, Inventario y Fichas Técnicas (Sprint 3)
// Implementa las secciones B y C de la arquitectura, y las reglas
// RN-020 a RN-042 de reglas_negocio_erp_mype.md.
// ---------------------------------------------------------------------

model Cliente {
  id                BigInt  @id @default(autoincrement())
  empresaId         BigInt  @map("empresa_id")
  empresa           Empresa @relation(fields: [empresaId], references: [id])
  nombre            String
  docIdentidad      String? @map("doc_identidad")
  telefono          String?
  tipo              String  @default("consumidor_final") // consumidor_final | frecuente
  creditoHabilitado Boolean @default(false) @map("credito_habilitado")
  limiteCredito     Decimal @default(0) @map("limite_credito") @db.Decimal(12, 2)

  ventas            Venta[]

  @@map("clientes")
}

model Insumo {
  id                   BigInt   @id @default(autoincrement())
  empresaId            BigInt   @map("empresa_id")
  empresa              Empresa  @relation(fields: [empresaId], references: [id])
  codigo               String?
  nombre               String
  categoriaId          BigInt?  @map("categoria_id")
  categoria            CategoriaInsumo? @relation(fields: [categoriaId], references: [id])
  unidadMedidaId       BigInt?  @map("unidad_medida_id")
  unidadMedida         UnidadMedida?    @relation(fields: [unidadMedidaId], references: [id])
  stockMinimo          Decimal  @default(0) @map("stock_minimo") @db.Decimal(10, 3)
  stockActual          Decimal  @default(0) @map("stock_actual") @db.Decimal(10, 3)
  costoPromedioActual  Decimal  @default(0) @map("costo_promedio_actual") @db.Decimal(10, 4)

  fichasTecnicas       FichaTecnica[]
  movimientos          MovimientoInventario[]
  mermas               Merma[]

  @@unique([empresaId, codigo])
  @@map("insumos")
}

model Producto {
  id              BigInt   @id @default(autoincrement())
  empresaId       BigInt   @map("empresa_id")
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  codigo          String?
  nombre          String
  categoriaId     BigInt?  @map("categoria_id")
  categoria       CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  tipo            String   // producto | servicio
  precioVenta     Decimal  @map("precio_venta") @db.Decimal(10, 2)
  requiereReceta  Boolean  @default(false) @map("requiere_receta")
  estado          String   @default("activo")

  fichaTecnica    FichaTecnica[]
  ventasDetalle   VentaDetalle[]

  @@unique([empresaId, codigo])
  @@map("productos")
}

// La "receta" de un producto: cuánto de cada insumo lleva (RN-020).
model FichaTecnica {
  id                  BigInt   @id @default(autoincrement())
  productoId          BigInt   @map("producto_id")
  producto            Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  insumoId            BigInt   @map("insumo_id")
  insumo              Insumo   @relation(fields: [insumoId], references: [id])
  cantidadRequerida   Decimal  @map("cantidad_requerida") @db.Decimal(10, 4)
  unidadMedidaId      BigInt?  @map("unidad_medida_id")
  unidadMedida        UnidadMedida? @relation(fields: [unidadMedidaId], references: [id])
  mermaEstandarPct    Decimal  @default(0) @map("merma_estandar_pct") @db.Decimal(5, 2)

  @@map("fichas_tecnicas")
}

model MovimientoInventario {
  id              BigInt   @id @default(autoincrement())
  empresaId       BigInt   @map("empresa_id")
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  insumoId        BigInt   @map("insumo_id")
  insumo          Insumo   @relation(fields: [insumoId], references: [id])
  tipo            String   // entrada_compra | salida_venta | merma | ajuste_manual
  cantidad        Decimal  @db.Decimal(10, 3)
  costoUnitario   Decimal  @map("costo_unitario") @db.Decimal(10, 4)
  fecha           DateTime @default(now())
  referenciaTipo  String?  @map("referencia_tipo")
  referenciaId    BigInt?  @map("referencia_id")
  usuarioId       String   @map("usuario_id") @db.Uuid

  @@index([insumoId, fecha])
  @@map("movimientos_inventario")
}

model Merma {
  id             BigInt   @id @default(autoincrement())
  empresaId      BigInt   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  insumoId       BigInt   @map("insumo_id")
  insumo         Insumo   @relation(fields: [insumoId], references: [id])
  cantidad       Decimal  @db.Decimal(10, 3)
  motivo         String   // vencimiento | desperdicio_preparacion | robo_diferencia | otro
  costoEstimado  Decimal  @map("costo_estimado") @db.Decimal(12, 2)
  fecha          DateTime @default(now())
  usuarioId      String   @map("usuario_id") @db.Uuid
  observacion    String?

  @@map("mermas")
}

model Venta {
  id            BigInt    @id @default(autoincrement())
  empresaId     BigInt    @map("empresa_id")
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  numero        String
  fecha         DateTime  @default(now())
  clienteId     BigInt?   @map("cliente_id")
  cliente       Cliente?  @relation(fields: [clienteId], references: [id])
  usuarioId     String    @map("usuario_id") @db.Uuid
  metodoPagoId  BigInt?   @map("metodo_pago_id")
  metodoPago    MetodoPago? @relation(fields: [metodoPagoId], references: [id])
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  descuento     Decimal   @default(0) @db.Decimal(12, 2)
  igv           Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  estado        String    @default("cobrada") // cobrada | pendiente | anulada

  detalle       VentaDetalle[]

  @@unique([empresaId, numero])
  @@map("ventas")
}

model VentaDetalle {
  id                       BigInt   @id @default(autoincrement())
  ventaId                  BigInt   @map("venta_id")
  venta                    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId               BigInt   @map("producto_id")
  producto                 Producto @relation(fields: [productoId], references: [id])
  cantidad                 Decimal  @db.Decimal(10, 3)
  precioUnitario           Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  costoUnitarioCalculado   Decimal  @default(0) @map("costo_unitario_calculado") @db.Decimal(10, 4)
  subtotal                 Decimal  @db.Decimal(12, 2)

  @@map("ventas_detalle")
}
